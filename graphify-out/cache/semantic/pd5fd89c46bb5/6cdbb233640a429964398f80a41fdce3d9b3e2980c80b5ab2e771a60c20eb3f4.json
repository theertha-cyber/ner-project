{"nodes": [{"id": "docs_observability_metric_contract_document", "label": "Metric contract: every metric family, its labels and closed value sets", "file_type": "document", "source_file": "docs/observability/metric-contract.md", "source_location": "lines 1-33", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_observability_metric_contract_tenant_label_allowlist", "label": "Tenant-label allowlist: 5 metric families may carry tenant_id", "file_type": "concept", "source_file": "docs/observability/metric-contract.md", "source_location": "lines 576-593", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "These five families are per-tenant consumption attribution, the one question trace sampling cannot answer accurately; a written frozenset (not a prefix) prevents an unreviewed family from admitting the label."}, {"id": "docs_observability_metric_contract_model_quality_exclusion", "label": "Model quality (F1/precision/recall/loss) deliberately absent from every metric family", "file_type": "concept", "source_file": "docs/observability/metric-contract.md", "source_location": "lines 24-28, 556-558", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MLflow already versions model quality against the run, params and artifact; a Prometheus mirror would be a second source of truth with worse fidelity and shorter retention."}, {"id": "docs_observability_metric_contract_entity_type_exclusion", "label": "Entity-type label deliberately absent from every metric family", "file_type": "concept", "source_file": "docs/observability/metric-contract.md", "source_location": "lines 29-33, 313-317", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entity types are tenant-configured; a metric label carrying them (e.g. policy_holder, claim_number) would identify a tenant's vocabulary to every dashboard user. Per-type counts live on the extraction run's span instead, which is tenant-scoped and expires with the trace (ADR-010)."}], "edges": [{"source": "docs_observability_metric_contract_document", "target": "src_shared_observability_domain_metrics_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/observability/metric-contract.md", "source_location": "lines 3-6", "weight": 1.0}, {"source": "docs_observability_metric_contract_document", "target": "scripts_generate_metric_contract_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/observability/metric-contract.md", "source_location": "lines 8-11", "weight": 1.0}, {"source": "docs_observability_metric_contract_document", "target": "docs_observability_metric_contract_tenant_label_allowlist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/observability/metric-contract.md", "source_location": "lines 20-22, 576-593", "weight": 1.0}, {"source": "docs_observability_metric_contract_document", "target": "docs_observability_metric_contract_model_quality_exclusion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/observability/metric-contract.md", "source_location": "lines 24-28", "weight": 1.0}, {"source": "docs_observability_metric_contract_document", "target": "docs_observability_metric_contract_entity_type_exclusion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/observability/metric-contract.md", "source_location": "lines 29-33", "weight": 1.0}], "hyperedges": []}