{"nodes": [{"id": "docs_decomposition_02_tenant_self_service_data_sources", "label": "Decomposition: Tenant Self-Service Data Sources", "file_type": "document", "source_file": "docs/decomposition/02-tenant-self-service-data-sources.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decomposition_02_cap2_connection_control_plane", "label": "CAP-2 \u2014 Tenant-Scoped Connection Control Plane", "file_type": "concept", "source_file": "docs/decomposition/02-tenant-self-service-data-sources.md", "source_location": "CAP-2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Foundation capability; extends the existing public integration-profile seam into a tenant-admin lifecycle for exactly two approved Azure provider types, with server-side tenant capability resolution so caller-provided identifiers are never authority."}, {"id": "docs_decomposition_02_cap3_azure_blob_sync", "label": "CAP-3 \u2014 Durable Azure Blob Synchronization and Source Reconciliation", "file_type": "concept", "source_file": "docs/decomposition/02-tenant-self-service-data-sources.md", "source_location": "CAP-3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routes through NormalizedDocument/DocumentIngestionService rather than a second pipeline; retains Blob bytes only in temporary working storage so no durable original copy accumulates in MinIO."}, {"id": "docs_decomposition_02_cap4_external_postgresql_query", "label": "CAP-4 \u2014 Contract-Governed External PostgreSQL Query Path", "file_type": "concept", "source_file": "docs/decomposition/02-tenant-self-service-data-sources.md", "source_location": "CAP-4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept distinct from platform SQL chat; a live-schema fingerprint must match the accepted contract before every query so drift blocks execution rather than silently returning wrong results."}, {"id": "docs_decomposition_02_cap5_admin_portal", "label": "CAP-5 \u2014 Tenant Data Source Administration Portal", "file_type": "concept", "source_file": "docs/decomposition/02-tenant-self-service-data-sources.md", "source_location": "CAP-5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consumes only safe backend contracts from CAP-2 through CAP-4; never renders secrets, connection strings, provider errors, SQL, or database rows."}, {"id": "docs_decomposition_02_cap6_local_compose_delivery", "label": "CAP-6 \u2014 Local Compose Delivery, Migration, and Operational Evidence", "file_type": "concept", "source_file": "docs/decomposition/02-tenant-self-service-data-sources.md", "source_location": "CAP-6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes the integrated feature locally deployable under the single approved dev Compose environment; no staging/production claim is introduced, matching ADR-014's explicit deferral of those environments."}], "edges": [{"source": "docs_decomposition_02_tenant_self_service_data_sources", "target": "docs_adr_014_local_compose_deployment_topology", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decomposition/02-tenant-self-service-data-sources.md", "source_location": "Source Documents list", "weight": 1.0}, {"source": "docs_decomposition_02_cap6_local_compose_delivery", "target": "docs_adr_014_local_compose_deployment_topology", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decomposition/02-tenant-self-service-data-sources.md", "source_location": "CAP-6 'Governed by: ADR-014'", "weight": 1.0}, {"source": "docs_decomposition_02_tenant_self_service_data_sources", "target": "docs_design_tenant_self_service_data_sources", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.