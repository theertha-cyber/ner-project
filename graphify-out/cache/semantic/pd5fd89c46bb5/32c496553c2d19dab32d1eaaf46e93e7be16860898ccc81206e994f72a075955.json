{"nodes": [{"id": "docs_architecture_document_ingestion_source_boundary", "label": "Document Ingestion Source Boundary (architecture proposal)", "file_type": "document", "source_file": "docs/architecture/document-ingestion-source-boundary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_document_ingestion_source_boundary_documentingestionservice", "label": "DocumentIngestionService (inbound port)", "file_type": "concept", "source_file": "docs/architecture/document-ingestion-source-boundary.md", "source_location": "\u00a74.2 Port 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single application use-case every adapter (upload, Keka, S3, Azure) calls; owns identity, validation, checksum, dedup, retention decision, row write, and dispatch, so provider knowledge never leaks past the seam."}, {"id": "docs_architecture_document_ingestion_source_boundary_documentcontent", "label": "DocumentContent (re-openable byte access port)", "file_type": "concept", "source_file": "docs/architecture/document-ingestion-source-boundary.md", "source_location": "\u00a74.2 Port 2, \u00a79.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "open() must be re-openable, not a one-shot buffer, so a non-retained document can still be reprocessed by re-fetching from its source instead of making platform retention mandatory and quietly defeating the privacy requirement."}, {"id": "docs_architecture_document_ingestion_source_boundary_originaldocumentstore", "label": "OriginalDocumentStore (outbound blob-storage port)", "file_type": "concept", "source_file": "docs/architecture/document-ingestion-source-boundary.md", "source_location": "\u00a74.2 Port 3, \u00a711.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "storage_reference must become an outcome (nullable) rather than an in